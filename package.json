{
  "name": "youtube-queues",
  "displayName": "YouTube Queues - Smart Watch Queue & Tab Manager",
  "version": "0.1.0",
  "description": "Organize YouTube videos into categorized, color-coded watch queues with tab groups, auto-discarding memory savings, and 1-click controls.",
  "author": "Brooks <brookayneabeba@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "plasmo dev",
    "dev:firefox": "plasmo dev --target=firefox-mv3",
    "build": "plasmo build",
    "build:chrome": "plasmo build --target=chrome-mv3",
    "build:firefox": "plasmo build --target=firefox-mv3",
    "package": "plasmo package",
    "package:chrome": "plasmo package --target=chrome-mv3",
    "package:firefox": "plasmo package --target=firefox-mv3",
    "package:all": "bun run package:chrome && bun run package:firefox"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.35",
    "prettier": "3.2.4",
    "tailwindcss": "^3.4.1",
    "typescript": "5.3.3"
  },
  "manifest": {
    "permissions": [
      "sidePanel",
      "tabs",
      "tabGroups",
      "storage",
      "contextMenus"
    ],
    "host_permissions": [
      "*://*.youtube.com/*",
      "*://*.youtu.be/*"
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "youtube-queues@brooks.dev",
        "strict_min_version": "138.0"
      }
    }
  }
}
